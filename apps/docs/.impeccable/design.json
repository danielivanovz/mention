  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled foreground action; shown at its landing size.",
      "html": "<a class=\"ds-primary\" href=\"/docs\">Start building <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:center;gap:.75rem;border:1px solid var(--fg,#172f52);border-radius:var(--radius,.375rem);min-height:4.6rem;padding:.8rem 1rem;font-size:clamp(1rem,1.45vw,1.4rem);font-weight:500;line-height:1.3;text-align:center;text-decoration:none;font-family:var(--font-body,\"Archivo\"),sans-serif;background:var(--fg,#172f52);color:var(--bg,#f3f7fc)}.ds-primary:hover{background:var(--fg-muted,#4a5f79)}.ds-primary:focus-visible{outline:2px solid var(--focus,#9c214a);outline-offset:4px;}.ds-primary svg{width:1.4rem;height:1.4rem;flex-shrink:0}@media(max-width:760px){.ds-primary{min-height:3.75rem;font-size:.9rem;gap:.35rem;padding:.6rem}.ds-primary svg{width:1rem}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined companion action; shared flat geometry.",
      "html": "<a class=\"ds-secondary\" href=\"/docs/agents\">Build with an agent <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-secondary{display:flex;align-items:center;justify-content:center;gap:.75rem;border:1px solid var(--fg,#172f52);border-radius:var(--radius,.375rem);min-height:4.6rem;padding:.8rem 1rem;font-size:clamp(1rem,1.45vw,1.4rem);font-weight:500;line-height:1.3;text-align:center;text-decoration:none;font-family:var(--font-body,\"Archivo\"),sans-serif;background:transparent;color:var(--fg,#172f52)}.ds-secondary:hover{background:var(--bg-elevated,#e6eef7)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#9c214a);outline-offset:4px;}.ds-secondary svg{width:1.4rem;height:1.4rem;flex-shrink:0}@media(max-width:760px){.ds-secondary{min-height:3.75rem;font-size:.9rem;gap:.35rem;padding:.6rem}.ds-secondary svg{width:1rem}}"
    },
    {
      "name": "Article action",
      "kind": "button",
      "refersTo": "docs-action",
      "description": "Compact article utility for focused Markdown retrieval.",
      "html": "<a class=\"ds-docs-action\" href=\"/llms.mdx/docs/content.md\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 2v6h6M8 13h8M8 17h8\"/></svg> Markdown</a>",
      "css": ".ds-docs-action{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:2.75rem;border:1px solid var(--border-subtle,#bdccde);border-radius:var(--radius,.375rem);background:var(--bg,#f3f7fc);padding:.5rem .75rem;color:var(--fg,#172f52);font-size:.8125rem;font-weight:500;text-decoration:none;font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-docs-action:hover{background:var(--bg-elevated,#e6eef7)}.ds-docs-action:focus-visible{outline:2px solid var(--focus,#9c214a);outline-offset:4px;}.ds-docs-action svg{width:14px;height:14px}"
    },
    {
      "name": "Writing field",
      "kind": "input",
      "refersTo": "textarea",
      "description": "The labeled working field in the landing specimen, without a simulated suggestion engine.",
      "html": "<div class=\"ds-field\"><label for=\"ds-specimen-input\">Try it. Type @, #, or /</label><textarea id=\"ds-specimen-input\" placeholder=\"Bring @someone into the conversation.\"></textarea></div>",
      "css": ".ds-field{padding:1rem 1.5rem .75rem;border-radius:var(--radius,.375rem);background:var(--pink-inset,#fac4d2);color:var(--ink,#172f52);font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-field label{display:block;margin-bottom:.625rem;font-size:clamp(1.125rem,1.6vw,1.6rem);font-weight:650;letter-spacing:-.02em}.ds-field textarea{display:block;width:100%;min-height:13rem;padding:1.125rem 1.375rem;border:1px solid var(--ink,#172f52);border-radius:var(--radius,.375rem);background:var(--bg,#f3f7fc);color:var(--fg,#172f52);font-size:clamp(1.375rem,2vw,2rem);line-height:1.5;resize:vertical;caret-color:#9c214a;font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-field textarea::placeholder{color:var(--fg-muted,#4a5f79);opacity:1}.ds-field textarea:focus-visible{outline:2px solid var(--ink,#172f52);outline-offset:3px}@media(max-width:760px){.ds-field{padding:.8rem}.ds-field label{font-size:1rem}.ds-field textarea{min-height:12.5rem;padding:.9rem;font-size:1.375rem}}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Persistent ink header shared by landing and docs. The compact material preview omits live search and theme behavior.",
      "html": "<header class=\"ds-header\"><a class=\"ds-brand\" href=\"/\" aria-label=\"Mention home\">mention</a><nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/#playground\">Playground</a><a href=\"/docs\">Docs</a><a href=\"https://github.com/danielivanovz/mention\">GitHub</a></nav></header>",
      "css": ".ds-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:4rem;padding:0 var(--page-inset,clamp(1.25rem,2.4vw,3rem));background:var(--ink,#172f52);color:var(--proof,#cfe6f3);border-bottom:1px solid #3c5270;font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-header a{color:inherit;text-decoration:none}.ds-brand{font-family:var(--font-display,\"Archivo Black\"),sans-serif;font-size:1.8rem;letter-spacing:-.04em;line-height:1}.ds-nav{display:flex;align-items:center;gap:clamp(.25rem,2vw,2rem)}.ds-nav a{display:inline-flex;align-items:center;min-height:2.75rem;padding:.3rem;font-size:1rem}.ds-header a:hover{color:#fff}.ds-header a:focus-visible{outline:2px solid var(--proof,#cfe6f3);outline-offset:4px}@media(max-width:600px){.ds-header{gap:.5rem}.ds-brand{font-size:1.5rem}.ds-nav{gap:.2rem}.ds-nav a{font-size:.8125rem}}"
    },
    {
      "name": "Editing-host choice",
      "kind": "card",
      "refersTo": "host-choice",
      "description": "Outlined destination with a quiet mixed-sheet fill.",
      "html": "<a class=\"ds-host-choice\" href=\"/docs/integrations/rich-text\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 2v6h6M8 13h8M8 17h8\"/></svg><span>Rich editor</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-host-choice{display:flex;gap:1rem;align-items:center;justify-content:center;padding:1.5rem 1.25rem;min-height:6.75rem;border:1px solid var(--fg,#172f52);border-radius:var(--radius,.375rem);background:color-mix(in srgb,var(--bg,#f3f7fc) 45%,transparent);color:var(--fg,#172f52);font-size:clamp(1rem,1.45vw,1.4rem);text-decoration:none;font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-host-choice:hover{background:var(--bg,#f3f7fc)}.ds-host-choice:focus-visible{outline:2px solid var(--focus,#9c214a);outline-offset:4px;}.ds-host-choice svg{flex-shrink:0}.ds-host-choice svg:first-child{width:2.5rem;height:2.5rem;stroke-width:1.7}.ds-host-choice svg:last-child{width:1.4rem;height:1.4rem;margin-left:auto}@media(max-width:760px){.ds-host-choice{min-height:5rem;padding:1rem}.ds-host-choice svg:first-child{width:2rem;height:2rem}}"
    },
    {
      "name": "People suggestions",
      "kind": "custom",
      "refersTo": "suggestion-popup",
      "description": "Selected-state appearance. Live pointer and keyboard state is supplied by Mention; no independent CSS hover highlight.",
      "html": "<div class=\"ds-popup\" role=\"listbox\" aria-label=\"Suggestions\"><div class=\"ds-option\" role=\"option\" aria-selected=\"true\"><span class=\"ds-avatar\" aria-hidden=\"true\">AC</span><strong>Alice Chen</strong></div><div class=\"ds-option\" role=\"option\" aria-selected=\"false\"><span class=\"ds-avatar\" aria-hidden=\"true\">JL</span><strong>Jordan Lee</strong></div><div class=\"ds-option\" role=\"option\" aria-selected=\"false\"><span class=\"ds-avatar\" aria-hidden=\"true\">SR</span><strong>Sam Rivera</strong></div></div>",
      "css": ".ds-popup{width:18rem;max-width:calc(100vw - 2rem);padding:.3rem;border:0;border-radius:var(--radius,.375rem);background:var(--bg,#f3f7fc);color:var(--fg,#172f52);box-shadow:0 6px 24px #071c3433;font-family:var(--font-body,\"Archivo\"),sans-serif;}.ds-option{display:flex;gap:.75rem;align-items:center;min-height:2.75rem;padding:.3rem .6rem;border-radius:.25rem;cursor:pointer;user-select:none;outline:none}.ds-option strong{font-size:1rem;font-weight:550;line-height:1.35}.ds-avatar{display:grid;place-items:center;flex:0 0 2.125rem;height:2.125rem;border-radius:50%;background:#172f52;color:#f3f7fc;font-size:.75rem;font-weight:650}.ds-option[aria-selected=\"true\"]{background:#fac4d2;color:#172f52}.ds-option[aria-selected=\"true\"] .ds-avatar{background:#a02a52}"
    },
